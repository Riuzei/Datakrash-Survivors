###############################################################################
# .gitattributes for Unity Projects (2025 Best Practices)
# Based on GameCI, Hextant Studios, and community refinements
# Ensures correct text handling, UnityYAMLMerge, and LFS tracking
###############################################################################

# Normalize line endings for text files
* text=auto

# Source control friendly merges for C# scripts
*.cs text diff=csharp eol=lf

###############################################################################
# --- Attribute Macros ---
###############################################################################
[attr]lfs               filter=lfs diff=lfs merge=lfs -text
[attr]unity-json        eol=lf linguist-language=json
[attr]unity-yaml        merge=unityyamlmerge eol=lf linguist-language=yaml

###############################################################################
# --- Unity Source Files ---
###############################################################################
*.cginc                 text eol=lf
*.compute               text linguist-language=hlsl eol=lf
*.hlsl                  text linguist-language=hlsl eol=lf
*.raytrace              text linguist-language=hlsl eol=lf
*.shader                text eol=lf

###############################################################################
# --- Unity JSON Files ---
###############################################################################
*.asmdef                unity-json
*.asmref                unity-json
*.index                 unity-json
*.inputactions          unity-json
*.shadergraph           unity-json
*.shadersubgraph        unity-json

###############################################################################
# --- Unity UI Toolkit Files ---
###############################################################################
*.tss                   text diff=css linguist-language=css eol=lf
*.uss                   text diff=css linguist-language=css eol=lf
*.uxml                  text linguist-language=xml linguist-detectable eol=lf

###############################################################################
# --- Unity YAML Files ---
###############################################################################
*.anim                  unity-yaml
*.asset                 unity-yaml
*.brush                 unity-yaml
*.controller            unity-yaml
*.flare                 unity-yaml
*.fontsettings          unity-yaml
*.giparams              unity-yaml
*.guiskin               unity-yaml
*.lighting              unity-yaml
*.mask                  unity-yaml
*.mat                   unity-yaml
*.meta                  unity-yaml
*.mixer                 unity-yaml
*.overrideController    unity-yaml
*.playable              unity-yaml
*.prefab                unity-yaml
*.prefabvariant         unity-yaml
*.preset                unity-yaml
*.renderTexture         unity-yaml
*.scenetemplate         unity-yaml
*.shadervariants        unity-yaml
*.signal                unity-yaml
*.spriteatlas           unity-yaml
*.spriteatlasv2         unity-yaml
*.terrainlayer          unity-yaml
*.unity                 unity-yaml
*.physicMaterial        unity-yaml
*.physicsMaterial2D     unity-yaml

###############################################################################
# --- Unity Baked Data / Special Binary Assets ---
###############################################################################
LightingData.asset          lfs
*NavMesh-*.asset            lfs
*TerrainData.asset          lfs
*LightProbes.asset          lfs
*ReflectionProbe-*.asset    lfs
*OcclusionCullingData.asset lfs

###############################################################################
# --- Third-Party & Generated ---
###############################################################################
Assets/Plugins/**           linguist-generated
Packages/packages-lock.json linguist-generated

